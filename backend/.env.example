# AI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna

# Server
PORT=3000
JSON_LIMIT=250mb
MAX_MEDIA_PER_REQUEST=20

# Telegram bot (for notifications/tests)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# GitHub build control
GITHUB_TOKEN=your_github_token_with_actions_write
GITHUB_REPO=izzatqalandarov169-sys/Superme_ai_chatgpt_model
GITHUB_WORKFLOW=superme-build.yml
GITHUB_REF=main
